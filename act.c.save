#include<stdio.h>
int main(){
int number,i;
unsigned long long factorial = 1;
char  letter;
printf("enter any letter: ");
scanf(" %c",&letter);
if(letter=='a'||letter=='A'||letter=='e'||letter=='E'||letter=='i'||letter=='I'||letter=='o'||letter=='O'||letter=='u'||letter=='U'||letter=='y'||letter=='Y'){
printf("\n %c is a vowel",letter);}
else{
printf("\nit's a consonne");}

printf("Enter number: ");
scanf(" %d",&number);

if(number<0){
printf("\nthe factorial of negative number is not define");
}else{
for(i=1;i<=number;++i){
factorial *= i;
}
}
printf(" %d! = %llu\n",number,factorial);

return 0;
}
